---
import { badgeImage, type ProjectEntry } from '../config/projects';

interface Props {
  project: ProjectEntry;
}
const { project } = Astro.props;
---

<li class="item">
  <a href={`/projects/${project.slug}`}>
    <div class="card">
      <div class="card-badges" style="display: flex">
        {
          project.badges.map((badge) => (
            <img src={badgeImage(badge)} alt={badge} class="tech-badge" width="48" height="16" />
          ))
        }
      </div>
      <div class="card-title">
        <span>{project.title}</span>
      </div>
      <div class="card-intro truncate">
        {project.intro.map((line) => <span>{line}</span>)}
      </div>
      <div class="card-image" style="position: relative; height: 200px">
        <img src={project.image} alt={project.imageAlt} style="object-fit: cover; width: 100%; height: 100%" />
      </div>
    </div>
  </a>
</li>

<style>
  .card-badges > img {
    width: 55px;
    height: 22px;
    margin-right: 6px;
    border: 1px solid #d2d2d2;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 290px;
    margin: 10px;
    min-height: 430px;
    background-color: var(--color-card-bg);
    transition: border 0.25s ease-in;
  }

  a .card-image img {
    position: relative;
  }
</style>
