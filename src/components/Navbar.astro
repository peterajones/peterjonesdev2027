---
import { getCollection, render } from 'astro:content';

const updateEntries = (await getCollection('updates')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Pre-resolve render() for every entry with Promise.all — an await inside a
// template-level .map() would return unresolved Promises into JSX instead
// of rendered content.
const updates = await Promise.all(
  updateEntries.map(async (entry) => {
    const { Content } = await render(entry);
    // z.coerce.date() on a bare "2019-06-24" parses as UTC midnight;
    // formatting without timeZone: 'UTC' would show the wrong day in
    // negative-UTC-offset zones.
    const date = entry.data.date.toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    });
    return { id: entry.id, date, Content };
  })
);
---

<nav class="nav">
  <div class="navContent">
    <div class="logo">
      <a href="/">
        <img
          class="logo-light"
          src="/images/my-logo.png"
          alt="logo"
          width="224"
          height="60"
        />
        <img
          class="logo-dark"
          src="/images/my-logo-dark.png"
          alt="logo"
          width="224"
          height="60"
        />
      </a>
    </div>
    <div class="topNavLinks">
      <a href="/projects">Projects</a>
      <a href="/blog">Blog</a>
      <a href="/news">News</a>
      <a href="/contact">Contact</a>
      <button
        id="theme-toggle"
        name="toggle theme"
        title="Toggle Theme"
        aria-label="Toggle Theme"
        class="faIcon"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 4V2m0 20v-2m8-8h2M2 12h2m14.14 6.14 1.42 1.42M4.44 4.44l1.42 1.42m0 12.28-1.42 1.42M19.56 4.44l-1.42 1.42M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.354 15.354A9 9 0 0 1 8.646 3.646 9.003 9.003 0 1 0 20.354 15.354Z"/>
        </svg>
      </button>
      <button
        id="updates-toggle"
        name="toggle updates modal"
        title="Latest Updates"
        aria-label="Toggle Updates Modal"
        class="faIcon"
      >
        <svg class="icon-bell" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 22a2.5 2.5 0 0 0 2.45-2H9.55A2.5 2.5 0 0 0 12 22Zm8-6-1.6-1.6V10a6.4 6.4 0 0 0-5.2-6.29V3a1.2 1.2 0 1 0-2.4 0v.71A6.4 6.4 0 0 0 5.6 10v4.4L4 16v1h16v-1Z"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<div id="updates-bg" class="updates-bg closed">
  <div id="updates-container" class="updates-container closed">
    <div class="modal-title">Latest Updates</div>
    <div class="updates-container-inner">
      {
        updates.map(({ id, date, Content }) => (
          <div class="update-content" data-id={id}>
            <div class="update-date">{date}</div>
            <div class="update-details">
              <Content />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  const THEME_KEY = 'theme';
  const root = document.documentElement;

  function toggleTheme() {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem(THEME_KEY, next);
    } catch {
      /* storage blocked — theme lasts for this page only */
    }
  }

  function toggleUpdatesModal() {
    const bg = document.getElementById('updates-bg');
    const container = document.getElementById('updates-container');
    const isOpen = bg?.classList.contains('open');
    bg?.classList.toggle('open', !isOpen);
    bg?.classList.toggle('closed', isOpen);
    container?.classList.toggle('open', !isOpen);
    container?.classList.toggle('closed', isOpen);
    document.body.style.overflow = isOpen ? 'unset' : 'hidden';
  }

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('updates-toggle')?.addEventListener('click', toggleUpdatesModal);
  document.getElementById('updates-bg')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) toggleUpdatesModal();
  });
</script>

<style>
  .logo-dark {
    display: none;
  }
  :global([data-theme="dark"]) .logo-light {
    display: none;
  }
  :global([data-theme="dark"]) .logo-dark {
    display: inline;
  }
  .icon-moon {
    display: none;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: none;
  }
  :global([data-theme="dark"]) .icon-moon {
    display: inline;
  }
</style>
