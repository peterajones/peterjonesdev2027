---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import { feeds } from '../../config/news';
---

<BaseLayout title="Peter Jones | News Feeds">
  <Banner src="/images/banners/News.jpg" />
  <div class="content" style="min-height: 2000px">
    <div class="fade-in visible">
      <h1 class="news page">RSS News Feeds</h1>
      <ul class="items-container">
        {
          feeds.map((feed) => (
            <li class="news item">
              <a href={`/news/${feed.slug}`}>
                <div class="item-content">
                  <img src={feed.image} width="100" height="100" alt="" />
                  <div class="item-title">{feed.title}</div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  li.news.item {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 290px;
    margin: 10px;
    min-height: 200px;
    transition: all 0.25s ease-in;
  }
  li.news.item:hover {
    scale: 1.15;
  }
  .item-content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  div.item-title {
    font-size: 1.4rem;
    font-weight: 500;
    padding: 10px 0;
    color: var(--color-text);
    transition: color 0.25s ease-in;
  }
</style>
