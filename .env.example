# Copy to .env for local dev (gitignored). In Coolify, set these as
# environment variables on the app instead of shipping a .env file.

# --- Contact form (src/pages/api/contact.ts) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=peter@peter-jones.ca

# --- Client-exposed API keys (used directly in the browser, same as the 2026 site) ---
PUBLIC_GOOGLE_MAPS_API_KEY=
PUBLIC_OPENWEATHER_API_KEY=
PUBLIC_EXCHANGE_RATES_API_KEY=
